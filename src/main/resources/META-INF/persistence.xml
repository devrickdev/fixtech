<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="fixtech-jpa" transaction-type="RESOURCE_LOCAL">
   
    <class>com.mycompany.fixtech.model.Administrador</class>
    <class>com.mycompany.fixtech.model.Atendente</class>
    <class>com.mycompany.fixtech.model.Atendimento</class>
    <class>com.mycompany.fixtech.model.Cliente</class>
    <class>com.mycompany.fixtech.model.Dispositivo</class>
    <class>com.mycompany.fixtech.model.Feedback</class>
    <class>com.mycompany.fixtech.model.ItemAtendimento</class>
    <class>com.mycompany.fixtech.model.Peca</class>
    <class>com.mycompany.fixtech.model.Usuario</class>
    <!-- uma linha para cada @Entity, com o pacote real -->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
  
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="javasenha"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>